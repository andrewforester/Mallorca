{
  "name": "mallorca-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run wasm && vite",
    "wasm": "node scripts/wasm.ts",
    "prebuild": "npm run wasm",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "pretest": "npm run wasm",
    "test": "vitest run",
    "test:golden": "vitest run --config vitest.golden.config.ts",
    "test:e2e": "playwright test",
    "prearena": "npm run wasm",
    "arena": "node tools/arena/cli.ts",
    "arena:ui": "vite --config tools/arena/ui/vite.config.ts",
    "arena:publish": "node tools/arena/publishCli.ts",
    "contact": "npm run build && node e2e/contact.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint . --fix"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.6",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "fast-check": "^4.10.2",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "i18next": "^26.5.6",
    "phe": "^0.6.0",
    "preact": "^11.0.1",
    "zustand": "^5.0.16"
  }
}
