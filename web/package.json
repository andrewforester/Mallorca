{
  "name": "mallorca-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run wasm && vite",
    "wasm": "node scripts/wasm.ts",
    "portraits": "node tools/avatar/portraits.ts",
    "prebuild": "npm run wasm",
    "build": "tsc && vite build && vite build --config tools/arena/ui/vite.config.ts && node scripts/check-dist.ts",
    "preview": "vite preview",
    "pretest": "npm run wasm",
    "test": "vitest run --project node --project ui",
    "test:golden": "vitest run --project golden",
    "test:e2e": "playwright test",
    "bench": "vitest run --project bench",
    "prearena": "npm run wasm",
    "arena": "node tools/arena/cli.ts",
    "arena:ui": "vite --config tools/arena/ui/vite.config.ts",
    "arena:publish": "node tools/arena/publishCli.ts",
    "arena:paired": "node tools/arena/pairedCli.ts",
    "lab": "vite --open /prototypes/emotion-lab/",
    "lab:shots": "node prototypes/emotion-lab/capture.ts",
    "lab:report": "node prototypes/emotion-lab/report.ts",
    "lab:talk-cases": "node prototypes/emotion-lab/talkCases.ts",
    "lab:talk-eval": "vite --open /prototypes/talk-eval/",
    "lab:talk-eval-data": "node prototypes/talk-eval/bundle.ts && prettier --write prototypes/talk-eval/report.json",
    "contact": "VITE_SUPABASE_URL=http://talk.test VITE_SUPABASE_ANON_KEY=contact-anon-key npm run build && node e2e/contact.ts",
    "contact:debug": "npm run wasm && node e2e/contactDebug.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint . --fix",
    "arena:external": "node tools/arena/external/cli.ts",
    "style-check": "npm run wasm && node tools/style-check/cli.ts",
    "prearena:external": "npm run wasm"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.6",
    "@types/node": "^24.19.2",
    "@types/three": "^0.187.0",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "fast-check": "^4.10.2",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "three": "^0.187.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "i18next": "^26.5.6",
    "phe": "^0.6.0",
    "preact": "^11.2.0",
    "zustand": "^5.1.0"
  }
}
